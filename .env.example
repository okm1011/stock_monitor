# Telegram 알림
# 1) BotFather 에서 봇 생성 -> TELEGRAM_BOT_TOKEN
# 2) 봇에게 /start 후 chat id 확인 -> TELEGRAM_CHAT_ID
# 3) python -m app telegram-test 로 확인

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 설정 웹 (http://서버IP:8080) — 비밀번호 + 세션 시크릿 필수
CONFIG_WEB_PASSWORD=여기에강한비밀번호
CONFIG_WEB_SECRET=랜덤긴문자열아무거나
CONFIG_WEB_HOST=0.0.0.0
CONFIG_WEB_PORT=8080
